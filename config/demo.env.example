# Demo configuration — copy to .env (or demo.env) and edit.
# Loaded by demo/config.py via python-dotenv. Values here are the defaults.

# ---------------------------------------------------------------- ingestion --
# live    : real Kafka stream, seek to end on first assignment (DEFAULT — safe)
# replay  : pinned offsets from config/replay_manifest.json (reproducible demo)
# catchup : consume the backlog, throttled by DEMO_MAX_BACKLOG
# rest    : Fink REST polling fallback (no credentials needed)
# offline : ReplayAdapter over archived .avro files (no network at all)
DEMO_MODE=live

# Space- or comma-separated Fink topics. See docs/demo-plan.md section 2.2.
DEMO_TOPICS=fink_sn_candidates_ztf,fink_early_sn_candidates_ztf,fink_blazar_ztf,fink_magnetic_cvs_ztf,fink_vra_ztf,fink_tns_match_ztf

# Kafka poll timeout, seconds. Matches -maxtimeout from fink_client_register.
DEMO_POLL_TIMEOUT_S=10

# Backpressure queue. When full the NEWEST record is dropped and counted.
DEMO_QUEUE_MAXSIZE=256

# Guard rails for the 4-day first-connection backlog.
DEMO_MAX_BACKLOG=500
DEMO_BACKLOG_CONFIRM_THRESHOLD=5000

# ---------------------------------------------------------------- inference --
# 1 = use seeded stub branches; the whole stack runs with no model artefacts.
DEMO_USE_STUBS=0

# Objects with fewer detections than this get no tabular prediction
# (matches Config.min_detections in build_dataset.ipynb).
DEMO_MIN_DETECTIONS=5

# ALeRCE feature resolution. Set to 0 to run image-only (no ALeRCE calls at all).
DEMO_ALERCE_ENABLED=1
DEMO_ALERCE_TIMEOUT_S=20
DEMO_FEATURE_CACHE_TTL_S=300

# ------------------------------------------------------------------ serving --
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=8000

# ------------------------------------------------------------------- paths ---
# Relative paths are resolved against the repository root.
DEMO_DATA_DIR=data/demo
DEMO_GOLD_DIR=data/gold
DEMO_MODELS_DIR=models
