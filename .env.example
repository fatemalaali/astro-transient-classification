# =============================================================================
#  astro-transient-classification — environment template
#  Copy to `.env` in the repository root and fill in.  `.env` is gitignored.
#
#      cp .env.example .env          # macOS / Linux
#      Copy-Item .env.example .env   # Windows PowerShell
#
#  Loaded by `python-dotenv` in build_dataset.ipynb and demo/config.py.
#  Real environment variables always win over values set here.
# =============================================================================

# -----------------------------------------------------------------------------
# TNS bot credentials  —  REQUIRED for build_dataset.ipynb (bronze/TNS stage)
# -----------------------------------------------------------------------------
# Get them from https://www.wis-tns.org :
#   1. Create a user account and confirm the e-mail.
#   2. Go to your profile -> "Bots" -> "Add bot".
#   3. The bot page shows the bot ID and the API key; the name is what you chose.
# Without these the TNS download is skipped with a warning and the dataset is
# built from BTS + VizieR only (fewer, brighter transients, no TNS-only extras).
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# -----------------------------------------------------------------------------
# Research-pipeline switches (all optional, all default to off)
# -----------------------------------------------------------------------------
# Smoke-test the dataset build with ~50 objects per class instead of the full caps.
# QUICK_TEST=1

# Shrink Optuna trials / bootstrap resamples in the classifier + fusion notebooks.
# LC_QUICK=1

# Fetch only 60 objects in fetch_ztf_lightcurves.ipynb instead of all 11,826.
# RQ3B_QUICK=1

# =============================================================================
#  Live demo (demo/, scripts/)  —  optional; only needed to run the dashboard.
#  These may live here or in `config/demo.env`; see config/demo.env.example for
#  the full annotated list. Fink Kafka credentials are NOT set here — they live
#  in ~/.finkclient/ztf_credentials.yml, written by `fink_client_register`.
# =============================================================================

# live | replay | catchup | rest | offline   (see docs/demo-guide.md section 3)
# DEMO_MODE=offline

# DEMO_TOPICS=fink_sn_candidates_ztf,fink_early_sn_candidates_ztf,fink_blazar_ztf,fink_magnetic_cvs_ztf,fink_vra_ztf,fink_tns_match_ztf

# 1 = run the whole stack on seeded stub models, with no model artefacts present.
# DEMO_USE_STUBS=0

# 0 = never call ALeRCE; every alert falls back to the image-only branch.
# DEMO_ALERCE_ENABLED=1

# DEMO_API_HOST=127.0.0.1
# DEMO_API_PORT=8000
